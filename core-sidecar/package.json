{
  "name": "tello-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tello core sidecar: Telegram (GramJS) + Zalo (zca-js) unified bridge",
  "scripts": {
    "dev": "bun run src/index.ts",
