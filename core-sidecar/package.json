  },
  "dependencies": {
    "image-size": "^2.1.0",
    "teleproto": "^1.233.0",
    "zca-js": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
